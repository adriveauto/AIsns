# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used to read and write the shared translation cache.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Translation (server only)
ANTHROPIC_API_KEY=your-anthropic-key
TRANSLATE_MODEL=claude-haiku-5-5

# Set to 1 after enabling the Google provider in Supabase (Authentication > Sign In / Providers)
NEXT_PUBLIC_GOOGLE_AUTH=

# Public site URL, used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twins: Vercel Cron sends this as a bearer token
CRON_SECRET=a-long-random-string
TWIN_MODEL=claude-sonnet-5-5

# Optional: max portraits drawn per day for people who are not signed in (default 300)
TRIAL_DAILY_CAP=
# Optional: contact email shown on the About and Privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: max AI model calls per day for everyone together (default 20000). Also set a monthly
# spend limit in the Anthropic console; this cap is a second safety net, not a replacement.
AI_DAILY_CAP=
# Optional: OpenAI's free Moderation API for checking chat messages and portrait text.
# Without it, Claude Haiku does the check.
OPENAI_API_KEY=
# Emails (comma separated) that can open /admin to handle reports and suspend accounts
ADMIN_EMAILS=
# Emergency stop: 1 stops every AI call (portraits, translation, twins). Redeploy after changing.
AI_PAUSED=
